# Required
ANTHROPIC_API_KEY=
APP_PASSWORD=          # password for logging in
SESSION_SECRET=        # random string, e.g. `openssl rand -base64 32`
CRON_SECRET=           # random string; Vercel Cron sends it as a bearer token

# Optional
DATABASE_URL=          # Neon Postgres; when empty, a local PGlite DB under .data/ is used
ANTHROPIC_MODEL=       # reading notes and monthly reviews; defaults to claude-opus-5-5
ANTHROPIC_CHAT_MODEL=  # article chat; defaults to claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=  # inbox summaries and Japanese walkthroughs; defaults to claude-haiku-5-5
